## 🛠 scripts/mint.ts
```ts
import { ethers } from "hardhat";

async function main() {
  const addr = process.env.CONTRACT_ADDRESS!;
  const mintPrice = process.env.MINT_PRICE_WEI || "100000000000000"; // 0.0001 ETH

  const emon = await ethers.getContractAt("EmojiMon", addr);
  const tx = await emon.mint({ value: mintPrice });
  const receipt = await tx.wait();
  console.log("Minted! hash:", receipt?.hash);
}

main().catch((e) => { console.error(e); process.exit(1); });
```

