## 🧪 test/EmojiMon.t.ts
```ts
import { expect } from "chai";
import { ethers } from "hardhat";

describe("EmojiMon", function () {
  it("mints and returns tokenURI", async () => {
    const [owner, user] = await ethers.getSigners();
    const Factory = await ethers.getContractFactory("EmojiMon");
    const emon = await Factory.deploy();
    await emon.waitForDeployment();

    const price = await emon.mintPrice();
    const tx = await emon.connect(user).mint({ value: price });
    await tx.wait();

    const uri = await emon.tokenURI(1);
    expect(uri).to.contain("data:application/json;base64,");
  });
});
```

