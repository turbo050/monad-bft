## 🛠 scripts/deploy.ts
```ts
import { ethers } from "hardhat";

async function main() {
  const Factory = await ethers.getContractFactory("EmojiMon");
  const emon = await Factory.deploy();
  await emon.waitForDeployment();
  console.log("EmojiMon deployed:", await emon.getAddress());
}

main().catch((e) => { console.error(e); process.exit(1); });
```

